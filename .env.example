# ============================================================================
# APEX Environment Configuration (.env.example)
# ============================================================================
# Copy this file to .env and adjust values for your environment
# ============================================================================

# ============================================================================
# Mock/API Mode Control
# ============================================================================
# When VITE_USE_MOCK=true, all API calls use Mock data from src/mock/
# When VITE_USE_MOCK=false, all API calls use real API backend
VITE_USE_MOCK=true

# ============================================================================
# API Configuration (used when VITE_USE_MOCK=false)
# ============================================================================
# Base URL for all backend API requests
VITE_API_BASE_URL=http://localhost:8000

# API version prefix (optional, defaults to empty)
# Examples: "v1", "api/v2" → final URL: http://localhost:8000/v1/goals
VITE_API_VERSION=

# ============================================================================
# Mock Scenario Control (used when VITE_USE_MOCK=true)
# ============================================================================
# Determines mock data behavior:
#   - "success" : Returns complete mock data (default)
#   - "empty"   : Returns empty lists (no goals, no tasks)
#   - "error"   : Throws mock errors for all requests
VITE_MOCK_SCENARIO=success

# ============================================================================
# Authentication: Google OAuth
# ============================================================================
# Google OAuth 2.0 Client ID for Google Sign-In button
# Get from: https://console.cloud.google.com/
# Leave empty to disable Google login
VITE_GOOGLE_CLIENT_ID=

# ============================================================================
# Authentication: Test Credentials (Mock Mode Only)
# ============================================================================
# These are the default test credentials when using Mock mode
# Login page auto-fills these for easy testing during development
# Default Email:    test@example.com
# Default Password: password123
# Note: These are shown in the login form hint in mock mode

# ============================================================================
# Session & Storage
# ============================================================================
# Session storage uses localStorage with this key structure:
# - Session: localStorage key "apex.session"
# - Format:  { token: string, user: { id, name, email, ... } }
# - Duration: Persists until logout() or localStorage.clear()
# 
# Mock Data Storage:
# - Key: "apex.mock-data.v1"
# - Contains: users, profiles, goals, tasks, plans, growthAnalytics
# - Reset: Call mockProvider.resetMockStore() or manual localStorage clear

# ============================================================================
# Optional: Development Features
# ============================================================================
# Enable detailed logging for provider/service layer (if supported)
# VITE_DEBUG_MODE=false

# Optional: Custom session storage prefix (advanced use)
# VITE_SESSION_PREFIX=apex

# ============================================================================
# QUICK START GUIDE
# ============================================================================
#
# 1. Local Development with Mock (DEFAULT):
#    VITE_USE_MOCK=true
#    VITE_MOCK_SCENARIO=success
#    → Frontend works 100% offline, no backend needed
#    → Login: test@example.com / password123
#
# 2. Testing Different Scenarios:
#    VITE_MOCK_SCENARIO=empty
#    → Test UI with no data
#    VITE_MOCK_SCENARIO=error
#    → Test error handling
#
# 3. Connecting to Real Backend:
#    VITE_USE_MOCK=false
#    VITE_API_BASE_URL=http://your-backend-server:8000
#    VITE_GOOGLE_CLIENT_ID=your-google-client-id
#    → All API calls go to real backend
#    → Mock data stored in localStorage is ignored
#
# 4. Production Build:
#    VITE_USE_MOCK=false
#    VITE_API_BASE_URL=https://api.yourproduction.com
#    VITE_GOOGLE_CLIENT_ID=your-production-google-client-id
#    → Frontend connects to production backend API
#
# ============================================================================
# BACKEND API SPECIFICATIONS
# ============================================================================
# When switching from Mock to real API, ensure backend implements:
#
# Authentication Endpoints:
#   - POST /auth/login                      { email, password }
#   - POST /auth/google                     { credential }
#   - POST /auth/otp/send                   { phone }
#   - POST /auth/otp/verify                 { phone, code }
#   - POST /auth/logout
#
# Goals Endpoints:
#   - GET  /goals                           (requires auth)
#   - POST /goals                           (create, requires auth)
#   - PUT  /goals/:id                       (update, requires auth)
#   - DELETE /goals/:id                     (requires auth)
#
# Tasks Endpoints:
#   - GET  /tasks                           (requires auth)
#   - POST /tasks                           (create, requires auth)
#   - PUT  /tasks/:id                       (update, requires auth)
#   - DELETE /tasks/:id                     (requires auth)
#
# Profile Endpoints:
#   - GET  /profile                         (requires auth)
#   - PUT  /profile                         (update, requires auth)
#
# Dashboard Endpoints:
#   - GET  /dashboard                       (aggregated data, requires auth)
#
# Analytics Endpoints:
#   - GET  /growth/analytics                (requires auth)
#
# AI/Plan Endpoints:
#   - POST /plans/generate                  { prompt } (requires auth)
#
# Authentication Header (for all protected endpoints):
#   Authorization: Bearer {token}
#
# See MOCK_ARCHITECTURE_AUDIT.md for complete specifications
#
# ============================================================================
